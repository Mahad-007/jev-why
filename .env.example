# Copy to .env and fill in. .env is gitignored.
TYPESAFE_API_KEY=

# Optional: pin a concrete model version. Attribution compares probabilities across
# calls, so a mid-run model rollout silently corrupts every delta. Prefer a pinned
# version over jev-latest for any run whose numbers you intend to publish.
# JEV_WHY_MODEL=jev-1.13.0
